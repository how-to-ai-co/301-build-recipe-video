{
  "name": "motion-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motion graphics made in code: index.html draws any moment with window.seek(t), render.mjs turns it into an MP4.",
  "scripts": {
    "postinstall": "playwright install chromium",
    "stills": "node stills.mjs",
    "render": "node render.mjs",
    "draft": "node render.mjs --fps 30 --sub 1",
    "audio": "node audio.mjs",
    "showreel": "node render.mjs --file examples/showreel.html --fps 30 --sub 1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.64.1"
  }
}
